DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/easyfood?schema=public"
PORT=3000

# Segredo dos tokens de login: troque por um texto longo e aleatório
JWT_SECRET="troque_por_um_segredo"

# Tamanho máximo das imagens enviadas (MB)
UPLOAD_MAX_SIZE_MB=5

# Endereço do site (usado no link do e-mail de recuperação de senha)
APP_URL="http://localhost:3000"

# E-mail (opcional). Sem SMTP, o e-mail aparece no terminal do servidor.
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 e uma "senha de app"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyFood <seu-email@exemplo.com>"
